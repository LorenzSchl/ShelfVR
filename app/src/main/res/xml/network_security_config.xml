<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext ist auf Plattformebene erlaubt, weil sich LAN-Adressen (IP-Bereiche) hier nicht
  freigeben lassen. Die App lässt HTTP trotzdem nur nach ausdrücklicher Zustimmung pro Server zu
  (CleartextGuardInterceptor, PROJECT_SPEC.md §3.2 Rev. 3). Zertifikate: nur System-CAs;
  selbst signierte Zertifikate erst mit eigenem Opt-in (NFR-05).
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Bewusst: siehe Kommentar oben. -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
