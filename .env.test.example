# Vorlage für .env.test – nach .env.test kopieren und ausfüllen. Die ausgefüllte Datei nicht committen.

# Server
ABS_VERSION=
ABS_URL_LOCAL=
ABS_URL_LAN=

# Admin (für Setup: Bibliothek scannen, User anlegen, Reset)
ABS_ADMIN_USER=
ABS_ADMIN_PASSWORD=

# Normaler Test-User (damit testet die App: Login, Sessions, Sync)
ABS_TEST_USER=
ABS_TEST_PASSWORD=

# Optional, falls Tests direkt per Token arbeiten sollen
ABS_TEST_API_TOKEN=

# Testbibliothek
ABS_LIBRARY_NAME=
ABS_LIBRARY_ID=
